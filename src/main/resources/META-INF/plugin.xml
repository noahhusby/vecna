<idea-plugin>
    <id>com.husbylabs.vecna</id>

    <name>Vecna</name>

    <vendor url="https://www.noahhusby.com">Noah Husby</vendor>


    <description><![CDATA[
    <p>
        Vecna provides native support for CAN database (DBC) files in all JetBrains IDEs,
        making it easier to view, edit, and maintain CAN bus communication definitions
        directly within your development environment.
    </p>

    <h3>Features</h3>
    <ul>
        <li><b>Syntax Highlighting</b> — Theme-aware highlighting for DBC keywords, signals, messages, nodes, and values.</li>
        <li><b>Language Parsing</b> — Structured recognition of DBC declarations and syntax.</li>
        <li><b>IDE Integration</b> — Native file type recognition and custom DBC file icons.</li>
        <li><b>Color Customization</b> — Dedicated highlighting categories for DBC language elements.</li>
    </ul>
]]></description>


    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- If the plugin is published on JetBrains Marketplace, errors reported by users are available on the plugin page.
             See https://plugins.jetbrains.com/docs/marketplace/error-handler.html#developers-side for details. -->
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <fileType name="DBC"
                  implementationClass="com.husbylabs.vecna.DbcFileType"
                  language="DBC"
                  extensions="dbc"/>
        <lang.syntaxHighlighterFactory
                language="DBC"
                implementationClass="com.husbylabs.vecna.DbcSyntaxHighlighterFactory"/>
        <lang.parserDefinition
                language="DBC"
                implementationClass="com.husbylabs.vecna.DbcParserDefinition"/>
        <annotator
                language="DBC"
                implementationClass="com.husbylabs.vecna.DbcAnnotator"/>
    </extensions>

</idea-plugin>
